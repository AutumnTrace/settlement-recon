{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http": "Warning"
      }
    }
  },
  "LogFormat": "Text",
  "Inbox": {
    "Root": "data",
    "PollInterval": "00:00:05"
  },
  "Storage": {
    "Provider": "InMemory",
    "Mongo": {
      "Database": "settlement_recon"
    }
  },
  "Reconciliation": {
    "AmountToleranceMinor": 1,
    "AmountToleranceBps": 5,
    "FeeToleranceMinor": 1,
    "DateWindowDays": 3,
    "AmountAndDateFallback": true
  },
  "Demo": {
    "SeedSampleRun": false
  },
  "AllowedHosts": "*"
}
