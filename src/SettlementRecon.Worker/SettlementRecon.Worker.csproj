<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>Worker service: watches an inbox folder, reconciles each dropped run and stores runs and breaks (MongoDB or in memory) behind a small REST API.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>settlement-recon-worker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SettlementRecon.Core\SettlementRecon.Core.csproj" />
    <ProjectReference Include="..\SettlementRecon.SampleData\SettlementRecon.SampleData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SettlementRecon.Tests" />
  </ItemGroup>

</Project>
